# ============================================================================
# 活体记忆系统 - Docker 部署环境变量示例（对齐 2026-08-10 稳定化架构）
# ----------------------------------------------------------------------------
# 用法:
#   cp .env.docker.example .env
#   然后填入真实值（尤其是 DEEPSEEK_API_KEY、LMS_CONTROL_TOKEN）
#   再执行: docker compose up -d --build
#
# 注意:
#   · .env 包含敏感信息（API Key / control token），请勿提交到版本库
#   · 容器内 LMS_SNAPSHOT_DIR 会被 compose 强制为 /app/snapshots，
#     本文件无需（也不应）写宿主机绝对路径
# ============================================================================

# ---------- LLM 配置 ----------
# DeepSeek API Key（与 LMS_LLM_API_KEY 二选一）
# 留空则禁用 LLM，/chat 端点仅返回记忆 context，/chat/simple 返回 503
DEEPSEEK_API_KEY=

# 备选 LLM API Key（与 DEEPSEEK_API_KEY 等效回退）
LMS_LLM_API_KEY=

# LLM 接口基础 URL（默认 DeepSeek 兼容接口，可改为任意 OpenAI 兼容服务）
LMS_LLM_BASE_URL=https://api.deepseek.com/v1

# LLM 模型名
LMS_LLM_MODEL=deepseek-chat

# ---------- 嵌入器（感官层） ----------
# 嵌入器类型:
#   simple     -- 纯 CPU、离线、秒级启动（无语义先验，仅测试）
#   pretrained -- 使用 sentence-transformers 预训练模型，需模型路径或联网下载
#   cloud      -- 调用远端 OpenAI 兼容 /v1/embeddings（生产推荐，本机即手机 Ollama bge-m3）
LMS_EMBEDDER=cloud

# 远端 embed 服务 URL（LMS_EMBEDDER=cloud 时生效）：
#   · 局域网直连（与手机同一网络，更快）: http://<LAN_IP>:11435/v1/embeddings
#   · 外网/容器网络（更稳，经隧道域名 443）: https://embed.example.com/v1/embeddings
#     （注意：域名 + 端口形式 http://embed.example.com:11435 实测不通，
#       隧道只放行 443；容器内建议用 https 隧道域名，避免依赖 LAN 可达性）
LMS_CLOUD_EMBED_URL=https://embed.example.com/v1/embeddings

# 备用 embed URL（主 URL 失败自动切换；可把 LAN 与隧道互为兜底）
LMS_CLOUD_EMBED_FALLBACK_URL=http://<LAN_IP>:11435/v1/embeddings

# 远端模型名与输出维度（bge-m3 = 1024）
LMS_CLOUD_EMBED_MODEL=bge-m3
LMS_CLOUD_EMBED_DIM=1024

# 预训练模型本地路径或 HuggingFace 模型名（仅 LMS_EMBEDDER=pretrained 时生效）
# 示例: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LMS_PRETRAINED_MODEL=

# 感官向量维度 / 吸引子网络节点数（cloud 嵌入会投影到此维度）
LMS_INPUT_DIM=64
LMS_NUM_NODES=256

# ---------- 服务监听（容器内固定值，与 docker-compose 端口映射对应）----------
# 监听地址（容器内必须为 0.0.0.0 才能接受宿主机/外部访问）
LMS_API_HOST=0.0.0.0
# 数据面监听端口（需与 docker-compose 端口映射及 Dockerfile EXPOSE 一致）
LMS_API_PORT=8190
# 快照目录（容器内路径；compose 已强制 /app/snapshots，此处仅示例）
LMS_SNAPSHOT_DIR=/app/snapshots

# ---------- 管理面（Control Plane，:8191，独立容器 lms-control）----------
# 管理面监听地址/端口（容器内 0.0.0.0；compose 映射为 127.0.0.1:8191）
LMS_CTRL_HOST=0.0.0.0
LMS_CTRL_PORT=8191
# 管理面聚合的数据面地址（容器内走服务名 lms，由 compose 注入）
# 宿主机裸进程部署时用 http://127.0.0.1:8190
LMS_CTRL_API_BASE=http://lms:8190
# 控制面认证 token（写端点必需；缺失 = 只读模式，写端点 503）。
# 生成: openssl rand -hex 32   （.env 中已有则保留原值）
LMS_CONTROL_TOKEN=

# ---------- 做梦调度器（DreamScheduler） ----------
# 会话空闲多少秒后自动触发做梦（记忆巩固）
DREAM_IDLE_THRESHOLD=300
# 每次做梦步数
DREAM_STEPS=30
# 是否启用完整七阶段做梦周期
DREAM_FULL_CYCLE=false
# 调度器检查间隔（秒）
DREAM_CHECK_INTERVAL=10

# ---------- 提取层 /store 写侧入口（阶段 1，api/server.py S1-1；对齐 .env.example）----------
# 灰度标记开关（1=期间 /store 条目带 gray 标记）
LMS_STORE_GRAY=0
# /store 每会话限流（次/分钟，超限 429；默认 30，灰度期建议 10）
LMS_STORE_RATE_LIMIT=30
# /store 幂等去重窗口（秒，同会话同内容窗口内去重；默认 60）
LMS_STORE_DEDUP_WINDOW=60
# /store 会话白名单（逗号分隔；默认 main）
LMS_STORE_SESSION_ALLOWLIST=main

# ---------- 做梦按价值重放（PER）与 episodic 上限（对齐 .env.example）----------
# PER 采样条数 k（默认 20）
LMS_DREAM_REPLAY_K=20
# PER 指数 α（默认 0.6，越大越偏向高价值条目）
LMS_DREAM_REPLAY_ALPHA=0.6
# episodic deque 硬顶兜底条数（默认 5000，防无界增长）
LMS_EPISODIC_HARD_CAP=5000

# ---------- 归档补充检索 / 快照 / 优雅停机（对齐 .env.example）----------
# 归档检索超时（毫秒，默认 500；超时 fail-open 只回内存结果）
LMS_ARCHIVE_TIMEOUT_MS=500
# 归档写锁超时（秒，默认 5；锁超时跳过本次写）
LMS_ARCHIVE_LOCK_TIMEOUT=5
# 启动时快照修剪：每会话保留最近 N 个轮次快照（默认 20）
LMS_SNAPSHOT_PRUNE_KEEP=20
# 快照写锁超时（秒，默认 5.0）
LMS_SNAPSHOT_LOCK_TIMEOUT=5.0
# 优雅停机窗口（秒，默认 30）
LMS_SHUTDOWN_GRACE_SECONDS=30
# 预训练模型加载超时（秒，默认 120）
LMS_MODEL_LOAD_TIMEOUT=120
# 事件总线文件路径（默认相对推导，一般不覆盖）
LMS_BUS_FILE=

# ---------- 算法治理开关（对齐阶段 2 / T2.8，默认关闭=保持原行为）----------
# 惊讶度归一化（core/hippocampus/attractor.py）：1=启用，0=关闭（默认）
LMS_NORM_SURPRISE=0
# J 范数钳制（治本，防止 ‖J‖² 主导自由能）：1=启用，0=关闭（默认）
LMS_J_TARGET_NORM=40.0
# 回放权重钳制（core/hippocampus/memory.py）：0=不钳制（默认）；>0 为 surprise 上限
LMS_REPLAY_SURPRISE_CAP=0
# long_term_latent 归一化（core/hippocampus/memory.py）：1=启用，0=关闭（默认）
LMS_NORM_LATENT=0
# meta 惰性规则（core/meta/meta_plasticity.py）：1=跳过 meta.update，0=正常（默认）
LMS_META_LAZY=0
# 自述 LLM 蒸馏跳过 bus 会话（core/hippocampus/self_referential.py）：1=启用，0=关闭（默认）
LMS_SELF_REF_NO_BUS=0
# 自指回路开关（设计基线：默认关闭 + 价值性验证）
LMS_SELF_REF_ENABLED=0
# 自述 LLM 蒸馏（每 N 轮一次；关闭=0）
LMS_SELF_REF_LLM_DISTILL_ENABLED=0
LMS_SELF_REF_LLM_DISTILL_INTERVAL=0
# embed 熔断器（core/sensory/circuit_breaker.py + runtime/loop.py）：1=启用（默认，与原生一致），0=关闭
LMS_EMBED_CIRCUIT=1
# 会话合并归档开关（runtime/loop.py + api/server.py）：1=启用（默认），0=关闭
LMS_ARCHIVE_ENABLED=1

# ---------- 备份体系（宿主机 scripts/lms_backup.sh 使用；容器内不消费）----------
# 备份根目录（15min 镜像 + 每日 tar.zst + MANIFEST.jsonl）
LMS_BACKUP_DIR=<LMS_BACKUP_ROOT>
# 跨机 rsync 目标（默认空 = 仅本机；如 user@host:/backups/lms）
REMOTE_BACKUP=
# 每日归档保留天数（默认 14）
BACKUP_KEEP_DAYS=14

# ---------- 审计日志 ----------
# 审计日志目录（默认 <项目根>/logs，按天轮转 audit-YYYYMMDD.jsonl，0600）
# LMS_AUDIT_DIR=

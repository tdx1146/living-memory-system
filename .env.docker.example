# ============================================================================
# 活体记忆系统 - Docker 部署环境变量示例
# 任务编号: E-P2-2
#
# 用法:
#   cp .env.docker.example .env
#   然后填入真实值（尤其是 DEEPSEEK_API_KEY）
#   再执行: docker compose up -d --build
#
# 注意: .env 包含敏感信息（API Key），请勿提交到版本库
# ============================================================================

# ---------- LLM 配置 ----------
# DeepSeek API Key（与 LMS_LLM_API_KEY 二选一）
# 留空则禁用 LLM，/chat 端点仅返回记忆 context，/chat/simple 返回 503
DEEPSEEK_API_KEY=

# 备选 LLM API Key（与 DEEPSEEK_API_KEY 等效回退）
LMS_LLM_API_KEY=

# LLM 接口基础 URL（默认 DeepSeek 兼容接口，可改为任意 OpenAI 兼容服务）
LMS_LLM_BASE_URL=https://api.deepseek.com/v1

# LLM 模型名
LMS_LLM_MODEL=deepseek-chat

# ---------- 嵌入器（感官层） ----------
# 嵌入器类型:
#   simple     -- 纯 CPU、离线、秒级启动（Docker 默认推荐）
#   pretrained -- 使用 sentence-transformers 预训练模型，效果更好但需模型路径或联网下载
LMS_EMBEDDER=simple

# 预训练模型本地路径或 HuggingFace 模型名（仅 LMS_EMBEDDER=pretrained 时生效）
# 示例: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LMS_PRETRAINED_MODEL=

# 感官向量维度
LMS_INPUT_DIM=64

# 吸引子网络节点数
LMS_NUM_NODES=256

# ---------- 服务监听 ----------
# 监听地址（容器内必须为 0.0.0.0 才能接受宿主机/外部访问）
LMS_API_HOST=0.0.0.0

# 监听端口（需与 docker-compose 端口映射及 Dockerfile EXPOSE 一致）
LMS_API_PORT=8000

# ---------- 做梦调度器（DreamScheduler） ----------
# 会话空闲多少秒后自动触发做梦（记忆巩固）
DREAM_IDLE_THRESHOLD=30

# 每次做梦步数
DREAM_STEPS=20

# 是否启用完整七阶段做梦周期
DREAM_FULL_CYCLE=false

# 调度器检查间隔（秒）
DREAM_CHECK_INTERVAL=5

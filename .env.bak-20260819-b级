# tests/test_discrimination_recovery.py suspect 判定单测）。
# =============================================================================

# ---- 判别力恢复（审计 §2.2 阶段三，env 键列：LMS_DOUBT_SURPRISE_FACTOR）---
# 门槛 = factor × j_target(40) = 50 > surprise_mean+2.5σ≈47.8
LMS_DOUBT_SURPRISE_FACTOR=1.25

# ---- 验证链灰度开启（审计 §2.2 阶段四：假阳性演练通过后灰度开）-----------
LMS_VERIFICATION_CHAIN_ENABLED=1

# ---- M7 双写回滚期（审计 §2.2 阶段二：双写 N 轮一致才切单写）--------------
LMS_M7_DUAL_WRITE_ROUNDS=30

# ---- 目的检查框架（总任务书 §二.5：每轮 [doubt] purpose-drift 判定）-------
LMS_PURPOSE_DRIFT_ENABLED=1
#LMS_PURPOSE_GOAL_TEXT=

# ---- S3 precision 学习化（默认关，观察期后开）------------------------------
LMS_PRECISION_LEARN=0
LMS_PRECISION_VAR_WINDOW=200
LMS_PRECISION_VAR_EMA=0.02
LMS_PRECISION_VAR_MIN=0.05
LMS_PRECISION_VAR_MAX=5.0

# ---- S4 EWC 保护（条件触发，默认关）----------------------------------------
LMS_EWC_ENABLE=0
LMS_EWC_LAMBDA=0.1
LMS_EWC_FISHER_WINDOW=500

# ---- 既有机制开关（回滚参照，勿随意改动）----------------------------------
LMS_DOUBT_INJECTION_ENABLED=1
LMS_PRECISION_ADAPT=1
LMS_J_ALLOSTATIC=0

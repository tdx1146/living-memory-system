# =============================================================================
# LMS 活体记忆系统 · 运行环境参数样例（2026-08-18 第二批管理者模式落地）
#
# 用法：复制为 .env（或 export 进运行环境）后重启运行时生效。
# 规范：§5.3 参数 env 化——env 名统一模块前缀+下划线，单一默认值来源在
#       各模块 docstring（本文件仅作运行侧样例，代码默认值以 docstring 为准）。
# 纪律：验证链开启必须过 B0 假阳性演练（tests/test_b0_false_positive_drill.py
#       全绿）——见 四妹-避免跑偏方案-20260818.md §四 序 2。
# =============================================================================

# ---- 验证链灰度开启（第二批项 1）------------------------------------------
# 默认 0=关（代码默认保守）。B0 假阳性演练通过后置 1 灰度开启，观测
# contradiction 率。conflict 结果由写侧 [doubt] conflict → labile。
LMS_VERIFICATION_CHAIN_ENABLED=1

# ---- 判别力恢复（第二批项 4）-----------------------------------------------
# LMS_DOUBT_SURPRISE_FACTOR 校准 1.2~1.3：门槛 = factor × j_target(40)
#   = 48~52 > surprise_mean+2.5σ≈47.8 → 常态条目放行、异常条目仍拦
# （修复判别器饱和 17/17 全 suspect）。一次一变量；改后须过 suspect 判定单测
# （tests/test_discrimination_recovery.py）。
LMS_DOUBT_SURPRISE_FACTOR=1.25

# ---- M7 双写回滚期（第二批项 3）--------------------------------------------
# 双写 N 轮增量一致（dual-write check --rounds N）后才切单写；任一不一致
# 禁止切单写。journal: data/migration/dualwrite-main/dual_write_journal.jsonl
LMS_M7_DUAL_WRITE_ROUNDS=30

# ---- 目的检查框架（第二批项 5）---------------------------------------------
# purpose-drift 时相与质疑系统融合：每轮 [doubt] purpose-drift 判定，输出
# 「是否偏离+理由」闸门信号（Pan 警示：不输出可被优化的分数）。
LMS_PURPOSE_DRIFT_ENABLED=1
# dsh-goal 目的文本（每轮判定消费；缺省回退内置总目的原文四词锚点）
#LMS_PURPOSE_GOAL_TEXT=

# ---- S3 precision 学习化（ABC §S3，默认关，观察期后开）--------------------
# π = 1/Var(surprise) 滑动窗口估计（EMA 低通，MIN/MAX 钳制防除零/爆值）；
# loop learn 侧 lr_multiplier 跟随 π（env 开关控制，off 与现状等价）。
LMS_PRECISION_LEARN=0
LMS_PRECISION_VAR_WINDOW=200
LMS_PRECISION_VAR_EMA=0.02
LMS_PRECISION_VAR_MIN=0.05
LMS_PRECISION_VAR_MAX=5.0

# ---- S4 EWC 保护（ABC §S4 条件触发，默认关；追赶/遗忘/扩展三信号触发才开）
LMS_EWC_ENABLE=0
LMS_EWC_LAMBDA=0.1
LMS_EWC_FISHER_WINDOW=500

# ---- E3 自我怀疑驱动的主动调节（2026-08-20，dandan 拍板 1-5）----------------
# 总开关默认 0=关（关 → 全部新路径零参与，行为与开关引入前逐位一致）。
# 部署验收顺序：A6（开关回归）→ A1（触发）→ A4（队列）→ A3（rewritten 2→3）
# → 到 A2（surprise 判据）停下叫 dandan 判断（代码只留观测字段不设阈值）。
LMS_E3_ENABLED=0
# self_pulse 侧触发开关（轻如烟 scripts/self_pulse_cli.py，plateau → /e3/review）
SELF_PULSE_E3_TRIGGER=0
# 候选入队后至少隔 N 轮才允许巩固期消费（根治同轮即消；调大 = 更多留给做梦）
LMS_E3_MIN_AGE_TURNS=1
# satiety 冷却（dandan 拍板放宽 24h→12h）；3 次闭环后待机 24h
LMS_E3_SATIETY_COOLDOWN_H=12
LMS_E3_SATIETY_MAX_CYCLES=3
LMS_E3_SATIETY_STANDBY_H=24
# 选择器权重（保守起步，验收后标定）与单次闭环最多重激活条数（拍板放宽 1→2）
LMS_E3_SELECTOR_ALPHA=0.5
LMS_E3_SELECTOR_BETA=0.3
LMS_E3_SELECTOR_GAMMA=0.2
LMS_E3_REACTIVATE_MAX=2
LMS_E3_REACTIVATE_TOPIC_LEN=120

# ---- 既有机制开关（回滚参照，勿随意改动）----------------------------------
LMS_DOUBT_INJECTION_ENABLED=1
LMS_PRECISION_ADAPT=1
LMS_J_ALLOSTATIC=0

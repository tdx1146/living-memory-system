# 活体记忆系统 - 环境变量配置示例
# 用法: 复制本文件为 .env 并填入真实值
#       cp .env.example .env
# 注意: .env 已被 .gitignore 忽略，不会被提交，请勿将真实 Key 写入本文件

# DeepSeek API Key（LLM 调用所需，与 LMS_LLM_API_KEY 二选一）
DEEPSEEK_API_KEY=sk-REPLACE_ME

# 自定义 LLM API Key（可选，备选方案）
# LMS_LLM_API_KEY=your-llm-api-key-here

# LLM Base URL（可选，默认指向 DeepSeek 兼容接口）
# LMS_LLM_BASE_URL=https://api.deepseek.com/v1

# LLM 模型名（可选，默认 deepseek-chat）
# LMS_LLM_MODEL=deepseek-chat

# ============================================================
# 嵌入器（Embedder）配置
# ============================================================

# 嵌入器类型: 'cloud' | 'pretrained' | 'simple'（默认 pretrained）
# - cloud:     通过 HTTP API 调用远程 embedding 服务（如 bge-m3）
# - pretrained: 本地加载 sentence-transformers 模型（384维 MiniLM）
# - simple:    随机初始化的冻结 embedding（无语义先验，仅用于测试）
LMS_EMBEDDER=cloud

# --- Cloud Embedder 配置（LMS_EMBEDDER=cloud 时生效）---
# 远程 embed 服务 URL（OpenAI 兼容的 /v1/embeddings 接口）
LMS_CLOUD_EMBED_URL=https://embed.example.com/v1/embeddings
# 备用 embed 端点（主 URL 失败自动切换，可空；本机 LAN→隧道 https://11435.tdx1146.cc/v1/embeddings）
# LMS_CLOUD_EMBED_FALLBACK_URL=
# 远程模型名
LMS_CLOUD_EMBED_MODEL=bge-m3
# 远程模型输出维度（bge-m3 为 1024）
LMS_CLOUD_EMBED_DIM=1024

# --- Pretrained Embedder 配置（LMS_EMBEDDER=pretrained 时生效）---
# 预训练模型名或本地路径（默认自动探测缓存目录）
# LMS_PRETRAINED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# 模型来源: 'huggingface' 或 'modelscope'（国内网络推荐 modelscope）
# LMS_EMBEDDER_SOURCE=modelscope
# 模型缓存目录（core/paths.py 自动探测；默认取 HF/ModelScope 标准缓存）
# HF_HOME=
# TRANSFORMERS_CACHE=
# MODELSCOPE_CACHE=

# ============================================================
# 网络结构配置
# ============================================================

# 感官向量维度（= embedding 投影后维度）
# LMS_INPUT_DIM=64
# 吸引子网络节点数
# LMS_NUM_NODES=256

# ============================================================
# 服务配置
# ============================================================

# API 服务监听地址
# LMS_API_HOST=127.0.0.1
# API 服务监听端口
# LMS_API_PORT=8190
# /feed 限流（次/分钟，超限 429，防总线风暴；默认 10）
# LMS_FEED_RATE_LIMIT=10
# 快照目录（.pt 状态文件；默认 <项目根>/snapshots）
# LMS_SNAPSHOT_DIR=
# 启动时快照修剪：每会话保留最近 N 个轮次快照（默认 20，防目录无限增长）
LMS_SNAPSHOT_PRUNE_KEEP=20
# 快照写锁超时（秒，默认 5.0；超时跳过本次写，不阻塞主流程）
LMS_SNAPSHOT_LOCK_TIMEOUT=5.0
# 优雅停机窗口（秒，默认 30；超时看门狗强制退出，防落盘卡死挂起）
LMS_SHUTDOWN_GRACE_SECONDS=30

# ============================================================
# 提取层 /store 写侧入口（阶段 1，api/server.py S1-1）
# ============================================================

# 灰度标记开关（1=期间 /store 条目带 gray 标记，用于灰度仪表观测；可随时改，无需重启）
LMS_STORE_GRAY=0
# /store 每会话限流（次/分钟，超限 429；默认 30，灰度期建议 10）
LMS_STORE_RATE_LIMIT=30
# /store 幂等去重窗口（秒，同会话同内容窗口内去重；默认 60）
LMS_STORE_DEDUP_WINDOW=60
# /store 会话白名单（逗号分隔；默认 main，M6 验收全用 main）
LMS_STORE_SESSION_ALLOWLIST=main

# ============================================================
# 做梦调度（阶段 1，runtime/dream_scheduler.py + dream_replay.py）
# ============================================================

# 做梦状态文件路径（默认 <runtime>/dream_state.json；测试/部署隔离可覆盖）
# LMS_DREAM_STATE_PATH=
# 做梦会话白名单（空=默认模式：仅排除 bus 系统会话；非空=仅白名单会话可做梦）
# DREAM_SESSION_ALLOW=
# 做梦调度参数（DreamScheduler 常驻线程；空闲触发阈值/步数/检查间隔）
# DREAM_IDLE_THRESHOLD=30
# DREAM_STEPS=20
# DREAM_CHECK_INTERVAL=5
# 做梦按价值重放（PER）：采样条数 k（默认 20）
LMS_DREAM_REPLAY_K=20
# PER 指数 α（默认 0.6，论文经验值；越大越偏向高价值条目）
LMS_DREAM_REPLAY_ALPHA=0.6
# episodic deque 硬顶兜底条数（默认 5000；deque 无界化后防无界增长，超顶丢最旧）
LMS_EPISODIC_HARD_CAP=5000

# ============================================================
# 归档检索（T2.3，core/archive/archive_store.py + runtime/loop.py）
# ============================================================

# 归档补充检索开关（1=启用（默认）；0=关闭，回退纯内存路径）
LMS_ARCHIVE_ENABLED=1
# 归档检索超时（毫秒，默认 500；超时 fail-open 只回内存结果）
LMS_ARCHIVE_TIMEOUT_MS=500
# 归档根目录（默认 <项目根>/data/archive）
# LMS_ARCHIVE_DIR=
# 归档写锁超时（秒，默认 5；锁超时跳过本次写，不阻塞主流程）
LMS_ARCHIVE_LOCK_TIMEOUT=5

# ============================================================
# 其他（模型加载 / 数据目录 / 自述持久化 / MCP 桥接）
# ============================================================

# 预训练模型加载超时（秒，默认 120）
LMS_MODEL_LOAD_TIMEOUT=120
# 数据根目录（默认 <项目根>/data；覆盖后归档/快照等子目录跟随）
# LMS_DATA_DIR=
# 自述 voice 持久化路径/目录（默认仓库内推导；显式指定可覆盖 cfg）
# LMS_SELF_VOICE_PATH=
# LMS_SELF_VOICE_DIR=
# 塑化发布间隔（轮，默认 10；Phase 4 钩子 LMS_PLASTIFIED_INTERVAL 可覆盖）
# LMS_PLASTIFIED_INTERVAL=10
# MCP HTTP 桥接（mcp_memory_server.py）
# LMS_URL=http://localhost:8190
# LMS_MCP_SESSION_ID=main
# tools/import_episodic.py CLI 默认 API 地址（默认 http://127.0.0.1:8190）
# LMS_API_BASE=http://127.0.0.1:8190

# ============================================================
# 自我配置端口 Control Plane（阶段 2 / T2.1·T2.3，:8191）
# ============================================================

# 控制面认证 token（写端点必需；缺失 = 只读模式，写端点 503）。
# 生成: openssl rand -hex 32
# LMS_CONTROL_TOKEN=
# 控制面监听地址/端口（默认 127.0.0.1:8191）
# LMS_CTRL_HOST=127.0.0.1
# LMS_CTRL_PORT=8191
# 控制面聚合的数据面地址（默认 http://127.0.0.1:8190）
# LMS_CTRL_API_BASE=http://127.0.0.1:8190

# ============================================================
# 备份体系（阶段 2 / T2.4，scripts/lms_backup.sh）
# ============================================================

# 备份根目录（15min 镜像 + 每日 tar.zst + MANIFEST.jsonl）
# LMS_BACKUP_DIR=<LMS_BACKUP_ROOT>
# 跨机 rsync 目标（默认空 = 仅本机；如 user@host:/backups/lms）
# REMOTE_BACKUP=
# 每日归档保留天数（默认 14）
# BACKUP_KEEP_DAYS=14
# 跨机 rsync 带宽限制 KB/s（默认 0 = 不限）
# RSYNC_BWLIMIT=0

# ============================================================
# 算法治理开关（阶段 2 / T2.8，全部默认关闭/保守 = 保持原行为）
# ============================================================

# 惊讶度归一化（core/hippocampus/attractor.py）
# 自由能 F ∝ ‖J‖²（实测 ±1600~3400），直接作为惊讶度会让回放权重/目的演化
# 对 J 幅度敏感。1=启用（F 除以 ‖J‖_F，量级收敛），0=关闭（默认，保持现状）
# LMS_NORM_SURPRISE=0   # ⚠️ 已弃用（v1.1 移除 F/‖J‖ 后为 no-op，仅兼容保留）

# 回放权重钳制（core/hippocampus/memory.py）
# consolidate 时 weight = replay_weight × max(min(surprise, cap), 0)
# 0=不钳制（默认）；>0 为 surprise 上限（防个别超大数值垄断回放权重）
# LMS_REPLAY_SURPRISE_CAP=0

# long_term_latent 归一化（core/hippocampus/memory.py）
# consolidate 结束后将 long_term_latent 除以其 L2 范数，防潜变量范数正反馈爆涨
# （实测 27614）。1=启用，0=关闭（默认）
# LMS_NORM_LATENT=0

# meta 惰性规则（core/meta/meta_plasticity.py）
# 元可塑性 4 条规则长期输出 ≈1.0（装饰性），1=跳过 meta.update（省算力，
# 倍率恒为 1.0 = 与未启用等价），0=正常元更新（默认）
# LMS_META_LAZY=0

# 自述 LLM 蒸馏跳过 bus 会话（core/hippocampus/self_referential.py）
# bus 已禁做梦（P1-4），此为兑底：bus 会话不用 LLM 蒸馏（防 1456 条
# 「我正高度唤醒…」套话继续污染 self_voice）。1=启用，0=关闭（默认）
# LMS_SELF_REF_NO_BUS=0

# embed 熔断器（core/sensory/circuit_breaker.py + runtime/loop.py）
# 连续 3 次失败 → 熔断 5 分钟；熔断期间 /recall 快速返回空（不卡 10s）
# 1=启用（默认，阶段1 v1.4 起：写侧 3 处 embed 全包熔断降级，M1 完整落实），0=关闭
LMS_EMBED_CIRCUIT=1

# ============================================================
# 审计日志（阶段 2 / T2.6，persistence/audit.py）
# ============================================================

# 审计日志目录（默认 <项目根>/logs，按天轮转 audit-YYYYMMDD.jsonl，0600）
# LMS_AUDIT_DIR=

# ============================================================
# 设计回归 2026-08-10（dandan 拍板：回到首版精神）
# ============================================================

# 自指回路开关（原始设计：默认关闭 + 价值性验证；8/5 曾被误开产生套话）
# 0=关闭（设计基线），1=开启实验
LMS_SELF_REF_ENABLED=0
# 自述 LLM 蒸馏（每 N 轮一次；关闭=0）
LMS_SELF_REF_LLM_DISTILL_ENABLED=0
LMS_SELF_REF_LLM_DISTILL_INTERVAL=0

# 惊讶度归一化/有界化：J 范数钳制（治本，防止 ‖J‖² 主导自由能导致惊讶度失真）
# 1=启用（J 每轮学习后钳制到 LMS_J_TARGET_NORM），0=关闭（J 无界增长）
LMS_NORM_SURPRISE=1
LMS_J_TARGET_NORM=40.0

# 事件总线文件路径（默认相对推导：<LMS根>/../Agent OS/iso-sand/data/event_bus.jsonl）
# 不硬编码任何机器路径
LMS_BUS_FILE=

# ============================================================
# 论文机制 A：allostatic J 滑动设定点（2026-08-17 实施，dandan 拍板）
# ============================================================
# 背景：固定 J 钳制在生产持续学习下漂移失效（J 内容漂移 → norm 工作点崩塌，
# 双快照复测实锤）。机制：J_target_norm 从固定常数 → surprise 序列统计
# 在线重估的滑动设定点（Mehra 1970 innovation 法 + Sterling 2012 allostasis）。
# 重锚方向：σ 饱和（frac_gt0.9 高）→ 设定点降；σ 崩塌（act05 极低）→ 设定点升；
# 动态健康 → 稳定。重锚按 step 增量、钳在 [MIN, MAX]、带 persist 轮确认。
# 0=关闭（默认，固定 J 行为完全不变，回滚干净），1=启用
LMS_J_ALLOSTATIC=0
# 初始设定点（allostatic 开启时仅作初值；关闭时=固定钳制值不变）
LMS_J_TARGET_NORM=7.0
# surprise 窗口长度（innovation 统计）
LMS_J_ALLOSTATIC_WINDOW=200
# 重锚阈值 k（z 带 ±k；持续越带 = 分布漂移证据）
LMS_J_ALLOSTATIC_K=2.0
# 每次重锚的设定点步长
LMS_J_ALLOSTATIC_STEP=0.5
# 越带持续轮数（防单轮抖动）
LMS_J_ALLOSTATIC_PERSIST=5
# 设定点上下限（护栏，防 runaway）
LMS_J_ALLOSTATIC_MIN=3.0
LMS_J_ALLOSTATIC_MAX=40.0
# 冷启动窗口样本数（不足不动作，保持初始设定点）
LMS_J_ALLOSTATIC_MIN_SAMPLES=30
# σ 饱和判定：|σ|>0.9 节点占比 ≥ 此值 → 饱和
LMS_J_ALLOSTATIC_SAT_FRAC=0.9
# σ 崩塌判定：|σ|>0.05 节点数 ≤ 此值 → 崩塌
LMS_J_ALLOSTATIC_COL_ACT=5
